\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\geometry{top=3cm, bottom=2.5cm, inner=2.2cm, outer=2.2cm, headsep=10pt, headheight=14pt, footskip=1.4cm}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.16}
\RequirePackage{chessboard}
\RequirePackage{graphicx}
\PassOptionsToPackage{obeyspaces}{url}
\RequirePackage[colorlinks,linkcolor=ocre,urlcolor=ocre,citecolor=ocre]{hyperref}
\RequirePackage[nonumberlist,toc]{glossaries}
\makeglossaries

%----------------------------------------------------------------------------
% Colours and text
%----------------------------------------------------------------------------
\definecolor{ocre}{RGB}{243,102,25}
\definecolor{night}{RGB}{38,42,51}
\definecolor{muted}{HTML}{666666}
\colorlet{bar}{ocre}
\setlength{\parindent}{0pt}
\nonzeroparskip

%----------------------------------------------------------------------------
% Headings (memoir)
%----------------------------------------------------------------------------
\renewcommand{\partnamefont}{\normalfont\Large\scshape\color{muted}}
\renewcommand{\partnumfont}{\normalfont\Large\scshape\color{muted}}
\renewcommand{\parttitlefont}{\normalfont\Huge\bfseries\color{ocre}}
\renewcommand{\chapnamefont}{\normalfont\large\scshape\color{muted}}
\renewcommand{\chapnumfont}{\normalfont\large\scshape\color{muted}}
\renewcommand{\chaptitlefont}{\normalfont\Huge\bfseries\color{ocre}}
\setsecheadstyle{\Large\bfseries\color{ocre}}
\setsubsecheadstyle{\large\bfseries\color{ocre}}
\setsecnumdepth{section}
\settocdepth{section}
\pagestyle{ruled}

%----------------------------------------------------------------------------
% Cover: \bookcover{Title}{Subtitle}{Author}
%----------------------------------------------------------------------------
\newcommand{\bookcover}[3]{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[night] (current page.south west) rectangle (current page.north east);
    % a large board, fading towards the top
    \begin{scope}[shift={([xshift=-7.2cm,yshift=1.5cm]current page.south)}]
      \foreach \x in {0,...,7} \foreach \y in {0,...,7} {
        \pgfmathsetmacro{\shade}{mod(\x+\y,2)==0 ? 5 : 14}% a1 dark, a8 and h1 light
        \pgfmathsetmacro{\fade}{1-\y/9}
        \fill[white,opacity=\shade/100*\fade] (1.8*\x,1.8*\y) rectangle ++(1.8,1.8);
      }
    \end{scope}
    \node[text=ocre,opacity=0.9] at ([xshift=2.7cm,yshift=6cm]current page.south)
      {\fontsize{150}{150}\selectfont\symrook};
    \node[text=white,opacity=0.85] at ([xshift=-2.7cm,yshift=4.2cm]current page.south)
      {\fontsize{110}{110}\selectfont\symking};
    % font= (not \fontsize inside the text): TikZ sets word spacing from the node font
    \node[anchor=north,align=center,text=white,text width=18cm,font=\fontsize{40}{50}\selectfont\bfseries]
      at ([yshift=-3.5cm]current page.north) {\hyphenpenalty=10000 #1};
    \node[anchor=north,align=center,text=ocre,text width=17cm,font=\fontsize{20}{26}\selectfont]
      at ([yshift=-10cm]current page.north) {#2};
    \node[anchor=north,align=center,text=white,font=\fontsize{18}{22}\selectfont\scshape]
      at ([yshift=-12.7cm]current page.north) {#3};
  \end{tikzpicture}%
  \clearpage}

% \xref{Chapter}{ch:meet}: a cross reference; the word and the number together are the link
\newcommand{\xref}[2]{\hyperref[#2]{#1~\ref*{#2}}}

% Vocabulary and glossary, as in peace_mind:
%   [context] = where the word applies (e.g. rook endings); the glossary shows
%               "side checks (rook endings)", the text shows "side checks"
%   #1 = key (no spaces, e.g. side-checks)
%   #2 = word as printed in the text (e.g. side checks)
%   #3 = meaning; if empty, no glossary entry is created (use it for later mentions)
\newcommand{\vocab}[4][]{%
  \ifstrempty{#4}{%
    \gls{#2}%
  }{%
    \ifstrempty{#1}%
      {\newglossaryentry{#2}{name={#3},description={#4}}}%
      {\newglossaryentry{#2}{name={#3 (#1)},text={#3},description={#4}}}%
    \gls{#2}%
  }%
}

% Index (as in peace_mind): \index{Rook endings!Side checks}; style in endgame.ist
\makeindex

% \chapterfile{file}{what to run if it is missing}
% For a draft of one chapter (compile.py --only), \egonly names that chapter and \eglist the
% list of endgame chapters; every other chapter file is skipped.
\newcommand{\eg@inputchapter}[2]{\IfFileExists{#1}{\input{#1}}{\par\textit{#1 is missing: #2}\par}}
\newcommand{\chapterfile}[2]{%
  \ifdefined\egonly
    \edef\eg@this{#1}%
    \ifx\eg@this\egonly \eg@inputchapter{#1}{#2}%
    \else\ifx\eg@this\eglist \eg@inputchapter{#1}{#2}\fi\fi
  \else \eg@inputchapter{#1}{#2}\fi}

% What a chapter means for the reader
\newenvironment{keypoints}
  {\par\needspace{7\baselineskip}\medskip\noindent{\color{ocre}\bfseries What this means for you}\par\nopagebreak\begin{itemize}}
  {\end{itemize}\medskip}

%----------------------------------------------------------------------------
% Chess
%----------------------------------------------------------------------------
% Chess figures in moves: \K e2, \R xc1+, e8=\Q
\newcommand{\K}{\symking}
\newcommand{\Q}{\symqueen}
\newcommand{\R}{\symrook}
\newcommand{\B}{\symbishop}
\newcommand{\N}{\symknight}

% \game{White (Elo)}{Black (Elo)}{Event}: printed by the next \diagram, under the Lichess link
\let\eg@game\relax
\newcommand{\game}[3]{\def\eg@game{\textbf{#1 -- #2}\par\nopagebreak{\small\color{muted}#3}\par\nopagebreak}}

% Boards: \egboard{FEN} (board-style.tex) draws one. A board already drawn by the board cache
% (output/boards, see src/endgame_book/boards.py) is placed as a picture instead, which is much faster.
\InputIfFileExists{board-style.tex}{}{\PackageError{endgame}{board-style.tex not found}{Compile from the repository folder.}}
\AtBeginDocument{\InputIfFileExists{output/boards/boards.tex}{}{}}
\def\eg@placeboard#1#2{\includegraphics[page=#2]{#1}}
\def\eg@board#1{\ifcsname eg@board@#1\endcsname
    \expandafter\expandafter\expandafter\eg@placeboard\csname eg@board@#1\endcsname
  \else\egboard{#1}\fi}

% \diagram[label]{FEN}: number, Lichess link, players, board
\newcounter{diagram}
\def\eg@url#1 #2 #3 #4 #5 #6\@nil{https://lichess.org/analysis/standard/#1_#2_#3_#4_#5_#6}
\newcommand{\diagram}[2][]{\refstepcounter{diagram}\if\relax\detokenize{#1}\relax\else\label{#1}\fi
  \par\needspace{17\baselineskip}\vspace{14pt}\begin{center}
  {\color{ocre}\bfseries Diagram~\thediagram}\par\nopagebreak
  \edef\eg@link{\eg@url#2\@nil}%
  \expandafter\href\expandafter{\eg@link}{\small Open on Lichess}\par\nopagebreak
  \eg@game\global\let\eg@game\relax
  \eg@board{#2}
  \end{center}\nopagebreak}

% \moves{61.\R b7? \K e6}: the moves of the game
\newcommand{\moves}[1]{\textbf{#1}}
% \seen{label}: the game reaches a position shown before
\newcommand{\seen}[1]{\par We have already seen this position in \xref{diagram}{#1}.\par}
